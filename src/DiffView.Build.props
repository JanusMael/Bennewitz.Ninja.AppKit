<Project>
  <!-- What every DiffView project sets and no other family's does, imported by each of them: the
       root Directory.Build.props is the repository's, and these would change what the other
       families' projects build. -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- A received file is what a gate rejected, written beside what it disagrees with for review:
         Verify's frames, ReferenceAuditTests' compat dictionaries, the theme audit's report. It is
         never a source. The Avalonia package's markup glob leaves out $(DefaultItemExcludes) as the
         SDK's own globs do, so this keeps a stray beside a theme from being compiled and embedded in
         any project here, and the library from packing it. ReceivedFileTests reads the glob back
         through MSBuild. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.received.*</DefaultItemExcludes>
  </PropertyGroup>
</Project>
