{
  // The upstream sources this repository builds against, fetched read-only into reference/src/ by
  // fetch-reference.cs, for reading and searching: no test, build or CI job reads them. Each is fetched at
  // the commit its packages' nuspecs record for the version Directory.Packages.props pins, so a raise
  // there leaves its checkout off its pin until the script runs with --update. "sparse" lists the folders
  // a checkout holds; without it, it holds everything. README.md beside this file describes every field.
  "sources": [
    {
      "name": "Avalonia",
      "dir": "reference/src/Avalonia",
      "packages": ["Avalonia", "Avalonia.Headless"],
      "sparse": ["src", "tests"]
    },
    {
      "name": "Avalonia.Controls.DataGrid",
      "dir": "reference/src/Avalonia.Controls.DataGrid",
      "packages": ["Avalonia.Controls.DataGrid"]
    },
    {
      "name": "Semi.Avalonia",
      "dir": "reference/src/Semi.Avalonia",
      "packages": ["Semi.Avalonia", "Semi.Avalonia.DataGrid"],
      "sparse": ["src"]
    }
  ]
}
