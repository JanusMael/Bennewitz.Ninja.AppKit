{
  // The family's ids in .github/repository.json against what DiffView packs, and against packages.push.
  // The release takes its ids from the family through scripts/release-target.cs, so the three mutations
  // of its two publishing steps went with the steps' own lists of ids.
  //
  //   dotnet run scripts/mutate-behaviour.cs -- --set tests/DiffView.Avalonia.Tests/Mutations/packages-push.json
  //
  // Every run is filtered to the one class, the green one included: the whole project holds
  // MutateBehaviourTests, which runs this harness's own script and so rebuilds the binary running it.
  "project": "tests/DiffView.Avalonia.Tests/DiffView.Avalonia.Tests.csproj",
  "class": "Bennewitz.Ninja.DiffView.Tests.PackagesPushTests",
  "tests": [
    "tests/DiffView.Avalonia.Tests/PackagesPushTests.cs"
  ],
  "mutations": [
    {
      "name": "the file loses an id the family names",
      "file": "packages.push",
      "old": "Bennewitz.Ninja.DiffView.Core\n",
      "new": "",
      "killer": "The_file_names_exactly_what_the_solution_packs_and_the_release_publishes",
      "says": "which packages.push does not"
    },
    {
      "name": "the family names an id nothing packs",
      "file": ".github/repository.json",
      "old": "\"Bennewitz.Ninja.DiffView.Core\",\n",
      "new": "\"Bennewitz.Ninja.DiffView.Core\",\n      \"Bennewitz.Ninja.DiffView.Probe\",\n",
      "killer": "The_file_names_exactly_what_the_solution_packs_and_the_release_publishes",
      "says": "Classify every packable project"
    },
    {
      "name": "the family loses an id DiffView packs",
      "file": ".github/repository.json",
      "old": "\"Bennewitz.Ninja.DiffView.Core\",\n      \"Bennewitz.Ninja.DiffView.Avalonia\"\n",
      "new": "\"Bennewitz.Ninja.DiffView.Avalonia\"\n",
      "killer": "The_file_names_exactly_what_the_solution_packs_and_the_release_publishes",
      "says": "Classify every packable project"
    },
    {
      "name": "a project becomes packable without being classified",
      "file": "src/DiffView.Demo/DiffView.Demo.csproj",
      "old": "<IsPackable>false</IsPackable>",
      "new": "<IsPackable>true</IsPackable>",
      "killer": "The_file_names_exactly_what_the_solution_packs_and_the_release_publishes",
      "says": "Classify every packable project"
    },
    {
      "name": "a packable project's id moves",
      "file": "src/DiffView.Core/DiffView.Core.csproj",
      "old": "<PackageId>Bennewitz.Ninja.DiffView.Core</PackageId>",
      "new": "<PackageId>Bennewitz.Ninja.DiffView.Model</PackageId>",
      "killer": "The_file_names_exactly_what_the_solution_packs_and_the_release_publishes",
      "says": "Classify every packable project"
    },
    {
      "name": "the reading of what the solution packs finds nothing",
      "file": "tests/DiffView.Avalonia.Tests/PackagesPushTests.cs",
      "old": "[.. PackagingTests.PackableProjects().Select(PackageIdOf).Order(StringComparer.Ordinal)]",
      "new": "[.. PackagingTests.PackableProjects().Take(0).Select(PackageIdOf).Order(StringComparer.Ordinal)]",
      "killer": "The_file_names_exactly_what_the_solution_packs_and_the_release_publishes",
      "says": "found no packable project",
      "because": "a reading that asserts only an agreement passes when both sides read nothing, so the positive control must trip first"
    },
    {
      "name": "the file lists its ids the other way round",
      "file": "packages.push",
      "old": "Bennewitz.Ninja.DiffView.Core\nBennewitz.Ninja.DiffView.Avalonia\n",
      "new": "Bennewitz.Ninja.DiffView.Avalonia\nBennewitz.Ninja.DiffView.Core\n",
      "expect": "green",
      "because": "the file is a set of ids, read here for what it lacks, and a set has no order"
    }
  ]
}
